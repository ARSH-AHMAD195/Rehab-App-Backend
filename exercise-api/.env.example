# --- Server ---
PORT=3002
NODE_ENV=development
# Swagger UI at /api/docs. Not behind auth, so keep false outside local development.
SWAGGER_ENABLED=false
# Websites allowed to call this API from a browser, comma-separated, e.g.
# https://your-app.vercel.app,http://localhost:5173. Empty = only the local Vite
# dev server (localhost:5173). The phone app does not need to be listed.
CORS_ORIGINS=

# --- Database ---
# The same database as the Auth and Health Monitoring APIs. Needs a replica set
# for transactions: start it with health-monitoring-api/docker-compose.yml.
MONGODB_URI=mongodb://localhost:27017/ffs_health?replicaSet=rs0&directConnection=true

# --- Auth (Firebase only, same project as the other two APIs) ---
# Service account for firebase-admin. Provide ONE of these:
#   a) path to the JSON key file
#   b) the JSON key inline (useful for CI secrets)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- YouTube ---
# Checks that an exercise video plays for patients (exists, Unlisted or Public,
# embedding allowed) when an admin saves it. A Google Cloud API key with the
# "YouTube Data API v3" enabled; restrict it to that API.
YOUTUBE_API_KEY=

# --- Fallbacks ---
# Used when a patient profile has no timeZone, or one that is not an IANA zone.
DEFAULT_TIME_ZONE=Asia/Kolkata
