# --- Server ---
PORT=3000
NODE_ENV=development
SWAGGER_ENABLED=true

# --- Database ---
# Needs a replica set (see docker-compose.yml) for the save transaction.
MONGODB_URI=mongodb://localhost:27017/ffs_health?replicaSet=rs0&directConnection=true

# --- Auth (Firebase only) ---
# Service account for firebase-admin. Provide ONE of these:
#   a) path to the JSON key file
#   b) the JSON key inline (useful for CI secrets)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Password for the Postman test users (scripts/create-firebase-test-users.ts).
# Required by that script. Choose your own; never commit it.
FIREBASE_TEST_PASSWORD=

# --- Fallbacks ---
# Used only when a patient profile has no timeZone set.
DEFAULT_TIME_ZONE=Asia/Kolkata
