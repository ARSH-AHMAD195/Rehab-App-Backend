# --- Server ---
# 3001, so it can run next to Health Monitoring (3000).
PORT=3001
NODE_ENV=development
# Swagger UI at /api/docs. Not behind auth, so keep false outside local development.
SWAGGER_ENABLED=false
# Websites allowed to call this API from a browser, comma-separated, e.g.
# https://your-app.vercel.app,http://localhost:5173. Empty = only the local Vite
# dev server (localhost:5173). The phone app does not need to be listed.
CORS_ORIGINS=

# --- Database ---
# The SAME database as Health Monitoring: both read the `users` collection.
# Needs a replica set (see docker-compose.yml) for transactions.
MONGODB_URI=mongodb://localhost:27017/ffs_health?replicaSet=rs0&directConnection=true

# --- Firebase ---
# Service account for firebase-admin. Provide ONE of these:
#   a) path to the JSON key file
#   b) the JSON key inline (useful for CI secrets)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Web API key (Firebase console -> Project settings -> General). Used to send
# the set-password emails through Firebase. Never commit the real value.
FIREBASE_WEB_API_KEY=

# Development only: password for the test logins made by `npm run seed:dev-users`.
# Choose your own; never commit it.
FIREBASE_TEST_PASSWORD=
